# Copy to .env and fill in. .env is never pushed to GitHub.

# The Supabase connection string (Project Settings -> Database -> Connection string).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Minimum discount in percent for an offer to be shown. Free games are always shown.
# Optional, defaults to 80 if omitted.
MIN_SAVINGS_PERCENT=80

# Max number of near-identical titles (same series) shown. 0 turns the cap off.
# Optional, defaults to 3 if omitted.
MAX_PER_SERIES=3

# How many seconds /offers and /free-games keep their answer in memory. 0 turns the cache off.
# Optional, defaults to 300 if omitted.
CACHE_SECONDS=300
