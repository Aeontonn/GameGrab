# Copy to .env.local and fill in. .env.local is never pushed to GitHub.

# The FastAPI backend. Leave empty to use http://localhost:8000.
VITE_API_URL=

# The Supabase project, used for login. Found under Project Settings → API Keys.
# Use the publishable key (sb_publishable_…). NEVER the secret key or service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
